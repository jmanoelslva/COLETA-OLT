# @coletor-olt@ (marca usada pelo install.sh para reconhecer os vhosts deste app)
# Exemplo de VirtualHost Apache para olt.hotnet.net.br (Coletor de OLTs)
#
# Serve o build estático do Vite (frontend/dist) e faz reverse proxy de
# /api/* para o coletor (FastAPI, serviço systemd em 127.0.0.1:8090 — ver
# deploy/install.sh). As rotas do coletor já começam com /api.
#
# O coletor não tem login próprio: o site todo (inclusive /api) exige
# usuário e senha (HTTP Basic, /etc/coletor-olt/htpasswd) e, se
# configurado no install.sh, só aceita os IPs liberados.
#
# Módulos: proxy proxy_http headers rewrite ssl auth_basic authn_file authz_host
# install.sh troca domínio, caminhos, porta e a lista de IPs sozinho.

<VirtualHost *:80>
    ServerName olt.hotnet.net.br

    # Renovação do certificado (certbot --webroot) sem senha.
    Alias /.well-known/acme-challenge/ /var/www/certbot-acme/.well-known/acme-challenge/
    <Directory /var/www/certbot-acme>
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://olt.hotnet.net.br%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName olt.hotnet.net.br

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/olt.hotnet.net.br/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/olt.hotnet.net.br/privkey.pem

    DocumentRoot /var/www/coletor-olt/dist

    # Senha (e IPs liberados) para tudo, inclusive /api.
    <Location />
        AuthType Basic
        AuthName "Coletor de OLTs"
        AuthUserFile /etc/coletor-olt/htpasswd
        <RequireAll>
            Require valid-user
            # IPs liberados (install.sh preenche a linha abaixo).
            # @IPS_LIBERADOS@
            Require all granted
        </RequireAll>
    </Location>

    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    <Directory /var/www/coletor-olt/dist>
        Options -Indexes
        AllowOverride None

        # index.html nunca em cache: é por ele que o navegador pega versão nova.
        Header always set Cache-Control "no-cache"

        # SPA: rota interna recarregada cai no index.html (react-router),
        # exceto /api/*, que segue para o ProxyPass.
        RewriteEngine On
        RewriteBase /
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_URI} !^/api/
        RewriteRule . /index.html [L]
    </Directory>

    # Arquivos com hash no nome: cache longo.
    <Directory /var/www/coletor-olt/dist/assets>
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </Directory>

    # Não repassa a senha do HTTP Basic para o coletor.
    RequestHeader unset Authorization
    RequestHeader set X-Real-IP "%{REMOTE_ADDR}e"

    # "Coletar agora" e "Testar acesso" podem esperar a fila da OLT (a CLI
    # atende um comando por vez) — timeout maior que o padrão.
    ProxyPreserveHost off
    ProxyPass        /api/ http://127.0.0.1:8090/api/ timeout=330
    ProxyPassReverse /api/ http://127.0.0.1:8090/api/
</VirtualHost>
